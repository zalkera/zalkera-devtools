{
    "name": "@zalkera/devtools-vscode",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "displayName": "잘커라(zalkera)",
    "description": "잘커라 사이트를 내 컴퓨터에서 열고, 프리뷰로 확인하고, 올립니다.",
    "publisher": "zalkera",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "zalkera.signIn",
                "title": "잘커라: 로그인",
                "category": "잘커라"
            },
            {
                "command": "zalkera.signOut",
                "title": "잘커라: 로그아웃",
                "category": "잘커라"
            },
            {
                "command": "zalkera.site.open",
                "title": "잘커라: 내 사이트 소스 받기",
                "category": "잘커라"
            },
            {
                "command": "zalkera.site.link",
                "title": "잘커라: 이 폴더를 내 사이트로 연결",
                "category": "잘커라"
            },
            {
                "command": "zalkera.preview.start",
                "title": "잘커라: 프리뷰 시작",
                "category": "잘커라"
            },
            {
                "command": "zalkera.preview.stop",
                "title": "잘커라: 프리뷰 중지",
                "category": "잘커라"
            },
            {
                "command": "zalkera.preview.restart",
                "title": "잘커라: 프리뷰 다시 시작",
                "category": "잘커라"
            },
            {
                "command": "zalkera.publish",
                "title": "잘커라: 발행",
                "category": "잘커라"
            },
            {
                "command": "zalkera.doctor",
                "title": "잘커라: 진단",
                "category": "잘커라"
            }
        ],
        "configuration": {
            "title": "잘커라",
            "properties": {
                "zalkera.apiBase": {
                    "type": "string",
                    "default": "https://api.zalkera.com",
                    "description": "잘커라 서버 주소. 값은 설정으로만 받습니다(소스에 박지 않습니다)."
                },
                "zalkera.tenant": {
                    "type": "string",
                    "default": "",
                    "description": "작업할 사이트(테넌트) 코드. 비우면 로그인 뒤 고릅니다."
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@zalkera/devtools-core": "0.0.0"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0"
    }
}
