{
    "name": "@zalkera/devtools-vscode",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "displayName": "잘커라(zalkera)",
    "description": "잘커라 사이트를 내 컴퓨터에서 열고, 프리뷰로 확인하고, 올립니다.",
    "publisher": "zalkera",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "zalkera.signIn",
                "title": "잘커라: 로그인",
                "category": "잘커라"
            },
            {
                "command": "zalkera.signOut",
                "title": "잘커라: 로그아웃",
                "category": "잘커라"
            },
            {
                "command": "zalkera.site.open",
                "title": "잘커라: 내 사이트 소스 받기",
                "category": "잘커라"
            },
            {
                "command": "zalkera.site.link",
                "title": "잘커라: 이 폴더를 내 사이트로 연결",
                "category": "잘커라"
            },
            {
                "command": "zalkera.preview.start",
                "title": "잘커라: 프리뷰 시작",
                "category": "잘커라"
            },
            {
                "command": "zalkera.preview.stop",
                "title": "잘커라: 프리뷰 중지",
                "category": "잘커라"
            },
            {
                "command": "zalkera.preview.restart",
                "title": "잘커라: 프리뷰 다시 시작",
                "category": "잘커라"
            },
            {
                "command": "zalkera.publish",
                "title": "잘커라: 발행",
                "category": "잘커라"
            },
            {
                "command": "zalkera.doctor",
                "title": "잘커라: 진단",
                "category": "잘커라"
            },
            {
                "command": "zalkera.site.create",
                "title": "잘커라: 예제로 시작",
                "category": "잘커라"
            },
            {
                "command": "zalkera.rollback",
                "title": "잘커라: 이전 버전으로",
                "category": "잘커라"
            },
            {
                "command": "zalkera.precheck",
                "title": "잘커라: 배포 전 검사",
                "category": "잘커라"
            },
            {
                "command": "zalkera.agent.connect",
                "title": "잘커라: 에이전트에 연결(MCP)",
                "category": "잘커라"
            }
        ],
        "configuration": {
            "title": "잘커라",
            "properties": {
                "zalkera.apiBase": {
                    "type": "string",
                    "default": "https://api.zalkera.com",
                    "description": "잘커라 서버 주소. **머신 범위**입니다 — 남의 소스 폴더(.vscode/settings.json)가 이 값을 바꿔 토큰을 가로채지 못하게 합니다.",
                    "scope": "machine"
                },
                "zalkera.tenant": {
                    "type": "string",
                    "default": "",
                    "description": "작업할 사이트(테넌트) 코드. 비우면 로그인 뒤 고릅니다."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "zalkera",
                    "title": "잘커라",
                    "icon": "media/zalkera.svg"
                }
            ]
        },
        "views": {
            "zalkera": [
                {
                    "id": "zalkera.sidebar",
                    "name": "사이트"
                }
            ]
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@zalkera/devtools-core": "0.0.0"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "이 확장은 폴더의 소스를 실행(개발 서버)하고 자격증명을 다룹니다. 신뢰한 폴더에서만 동작합니다."
        }
    }
}
