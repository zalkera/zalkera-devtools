# 번들(dist/extension.cjs)에 들어갔으므로 소스·타입·맵은 뺀다.
src/**
tsconfig.json
dist/**/*.map
dist/**/*.d.ts

# tsc 가 `typecheck`/`build` 때 남기는 ESM 산출물. 진입점은 `dist/extension.cjs` 하나이고,
# 이것들은 VSIX 에 없는 `@zalkera/devtools-core` 를 import 하는 **죽은 코드**다(심의 실측).
dist/*.js
!dist/extension.cjs
# ⚠ **CLI 번들은 남긴다 — 지금 확장 안에 부르는 자리는 없다.** 배송물 구성을 바꾸는 것은
#   위험 성격이 달라 별건으로 둔다(`runtime.ts` 의 `cliPath` 와 같은 판단).
#   위 `dist/*.js` 가 이것까지 걷어내므로 예외를 명시한다.
!dist/zalkera-cli.js

# core 는 번들에 들어갔다. 워크스페이스 링크는 확장 폴더 **밖**을 가리켜 VSIX 경로 규칙을 깬다.
node_modules/@zalkera/**
node_modules/.bin/**
node_modules/.package-lock.json

# npm CLI 는 남긴다(자식 프로세스로 실행하는 실물). 문서·맨페이지만 덜어낸다.
node_modules/npm/docs/**
node_modules/npm/man/**
