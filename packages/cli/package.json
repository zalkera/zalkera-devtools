{
    "name": "@zalkera/cli",
    "version": "0.20.2",
    "description": "잘커라 사이트 소스를 터미널에서 받고·올리고·발행합니다. 편집기 없이, 스크립트에서도.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "zalkera": "./dist/main.js"
    },
    "main": "./dist/main.js",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zalkera/zalkera-devtools.git",
        "directory": "packages/cli"
    },
    "homepage": "https://zalkera.com",
    "bugs": {
        "url": "https://github.com/zalkera/zalkera-devtools/issues"
    },
    "keywords": [
        "zalkera",
        "잘커라",
        "storefront",
        "headless-cms",
        "korean",
        "cli"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
        "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --alias:@zalkera/devtools-core=../core/dist/index.js --outfile=dist/main.js"
    }
}
